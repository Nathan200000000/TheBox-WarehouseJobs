# Copy to .env.local for local development.

# Auth.js session secret: generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=

# Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application")
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Emails (comma-separated) allowed to open /admin/reports
ADMIN_EMAILS=

# Private Vercel Blob store for saved employers and scam reports.
# Leave empty locally to store data in .data/ instead.
BLOB_READ_WRITE_TOKEN=

# Local testing only: adds a "Test account" sign-in that skips Google (never active on Vercel).
# AUTH_DEV_LOGIN=1
